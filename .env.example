# Telegram API 参数请在 https://my.telegram.org/apps 获取，并只保存在本机 .env。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 可选：指定要匹配的账号用户名，不带 @；留空则读取登录账号的用户名。
TELEGRAM_USERNAME=
# 可选：手机号使用国际格式；留空时登录过程会在终端询问。
TELEGRAM_PHONE=
# 角色固定身份为 ChatGPT 龙娘；账号切换器 DISPLAY_NAME 仅作账号配置标签。

# OpenAI Responses API 的旧版共享默认值；账号管理器会把缺失项迁移到本机 profiles/<账号>.env。
# 新设置按账号独立保存；密钥不要提交或分享。
OPENAI_API_KEY=
OPENAI_MODEL=
# 可选：当前账号额外的人设/模型固有提示词；账号管理器可单独编辑。
MODEL_SYSTEM_PROMPT=
# 可选：OpenAI-compatible 服务地址；接入模型时再填写。
OPENAI_BASE_URL=
# 可选：单独指定语音服务；留空时沿用 OPENAI_BASE_URL / OPENAI_API_KEY。
OPENAI_AUDIO_BASE_URL=
OPENAI_AUDIO_API_KEY=
# 旧版共享生图默认值；账号管理器中的“生图设置”会按当前账号保存。
IMAGE_GENERATION_ENABLED=true
# 可选：图片生成服务；留空时沿用 OPENAI_BASE_URL / OPENAI_API_KEY。
# 必须填写服务支持的图片模型名称；参考图还需支持 /images/edits。
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=
# 可选尺寸，例如 1024x1024；留空时使用服务默认值。
OPENAI_IMAGE_SIZE=
# 聊天联网与生图联网共用此开关；生图具名人物/事件会先搜索，服务需支持 Responses web_search。
WEB_SEARCH_ENABLED=true
# 仅当当前 @/回复消息包含“发语音”时合成语音；其他情况只发文字。
# 网关不支持音频接口时会退回文字。主开关可设为 false 禁用语音。
VOICE_REPLY_ENABLED=true
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
VOICE_REPLY_VOICE=alloy
# 本地联调专用：填写后收到白名单群 @ 时会发送固定文本，不调用模型；测试完请清空。
TEST_REPLY_TEXT=

# 正常监听时必填。先运行 `python main.py --list-chats` 获取群组 ID。
# 只加入允许监听、且成员知道会启用自动处理的群组。
ALLOWED_CHAT_IDS=
# 可选：允许触发 AI 的 Telegram 用户 ID，逗号分隔；留空表示不限制白名单群内的用户。
ALLOWED_SENDER_IDS=
# 可选：主人身份用户 ID，逗号分隔；主人也可触发智能体，但不会绕过 Telegram/程序限制。
OWNER_USER_IDS=
# 可选的主人 Telegram 用户名备用匹配，逗号分隔，可带 @；用户名可变，不能替代数字 ID。
OWNER_USERNAMES=

# 上下文与发送节奏
CONTEXT_MESSAGES=5
CONTEXT_MAX_CHARS=2000
CHAT_COOLDOWN_SECONDS=5
REPLY_DELAY_SECONDS=2
GLOBAL_SEND_INTERVAL_SECONDS=5
MAX_REPLY_UTF16_UNITS=3500

# 本地状态文件；不要分享登录 session 或数据库。
SESSION_PATH=data/telegram_userbot
STATE_PATH=data/state.sqlite3
LOG_LEVEL=INFO
